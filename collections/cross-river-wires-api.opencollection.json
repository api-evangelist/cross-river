{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cross River Operating System (COS) Accounts Wires API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://idptest.crbcos.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Wires",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a wire transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.crbcos.com/wires/v1/payments",
            "headers": [
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends a single domestic wire transfer payment. MODELED request body."
        },
        {
          "info": {
            "name": "Cancel a wire transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.crbcos.com/wires/v1/payments/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Cancels a wire transfer payment by ID."
        }
      ]
    }
  ],
  "bundled": true
}